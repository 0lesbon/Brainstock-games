# Copie para .env (local) ou cadastre como Secrets no GitHub (Settings > Secrets and variables > Actions)

# Obrigatório: sua chave da ElevenLabs
ELEVENLABS_API_KEY=
# Opcional: ID da voz (Voice Library da ElevenLabs). Se vazio, usa o valor de config.json
ELEVENLABS_VOICE_ID=

# Recomendado: chave de IA para escrever o roteiro (use uma das duas; o Gemini tem prioridade).
# Sem nenhuma, a narração é o título + resumo do próprio RSS.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modo e-mail (padrão): recebe o vídeo pronto + legenda no Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcional: outro endereço para receber (padrão: o próprio GMAIL_USER)
EMAIL_TO=

# Opcional: fotos de banco de imagens mais bonitas (grátis em pexels.com/api)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcional: postagem automática via API do Metricool (plano Advanced ou superior)
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
