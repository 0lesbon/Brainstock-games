# Copie para .env (local) ou cadastre como Secrets no GitHub (Settings > Secrets and variables > Actions)

# Obrigatório: sua chave da ElevenLabs
ELEVENLABS_API_KEY=
# Opcional: ID da voz (Voice Library da ElevenLabs). Se vazio, usa o valor de config.json
ELEVENLABS_VOICE_ID=

# Recomendado: escreve o roteiro com o Claude. Sem ela, usa o resumo do próprio RSS.
ANTHROPIC_API_KEY=

# Opcional: postagem automática via API do Metricool (plano Advanced ou superior)
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
